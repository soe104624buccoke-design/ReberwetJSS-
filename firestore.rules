rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all unspecified routes
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins or Super Admins
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'koechybett544@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User profiles (Teachers & Admins)
    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId);
      allow create: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Enrolled Learners
    match /learners/{learnerId} {
      allow read: if isSignedIn() && isValidId(learnerId);
      allow create, update: if isSignedIn() && isValidId(learnerId);
      allow delete: if isAdmin() && isValidId(learnerId);
    }

    // Marks / Assessment Scores
    match /marks/{markId} {
      allow read: if isSignedIn() && isValidId(markId);
      allow create, update: if isSignedIn() && isValidId(markId);
      allow delete: if isAdmin() && isValidId(markId);
    }

    // Attendance Records
    match /attendance/{recordId} {
      allow read: if isSignedIn() && isValidId(recordId);
      allow create, update: if isSignedIn() && isValidId(recordId);
      allow delete: if isAdmin() && isValidId(recordId);
    }

    // School Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn() && isValidId(announcementId);
      allow create, update: if isSignedIn() && isValidId(announcementId);
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // School Documents
    match /documents/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
      allow create, update, delete: if isSignedIn() && isValidId(docId);
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
